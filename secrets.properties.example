# Copy to secrets.properties (same folder you run the app from) and fill in.
# Every key can also be supplied as an environment variable instead,
# e.g. spring.datasource.password -> SPRING_DATASOURCE_PASSWORD, jwt.secret -> JWT_SECRET.

spring.datasource.url=jdbc:sqlserver://<host>:1433;databaseName=<db>;encrypt=true;trustServerCertificate=true;
spring.datasource.username=<db-user>
spring.datasource.password=<db-password>

spring.mail.username=<gmail-address>
spring.mail.password=<gmail-app-password>

google.client.secret=<google-oauth-client-secret>
google.refresh.token=<google-oauth-refresh-token>

# At least 32 random characters (HS256)
jwt.secret=<long-random-string>

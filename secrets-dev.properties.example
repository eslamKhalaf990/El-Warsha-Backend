# Copy to secrets-dev.properties (project root) and fill in. Used by the "dev" profile.
# Keys not set here fall back to secrets.properties (e.g. mail and Google credentials).

spring.datasource.url=jdbc:sqlserver://<host>:1433;databaseName=WarshaDB_Dev;encrypt=true;trustServerCertificate=true;
spring.datasource.username=<db-user>
spring.datasource.password=<db-password>
